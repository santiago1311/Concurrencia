			if(cabinaLibre(cabinas, idCab)){//esta función devolverá una cabina libre en idCab, es booleana
			send tomaCabina[idCliente] (idCab);
			cabinas[idCab] = false;} else{
				encolar(clientes,idCliente);//armo una cola paralela de clientes ya esperando para maximizar concurrencia
			}
		fi
	}
	
}
	

