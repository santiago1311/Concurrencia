		if
		::(!empty(dejeCabina))->
			receive dejeCabina(idCliente, idCab);
			Cobrar(factura); //cobra y genera la factura
			send facturas[idCliente](factura);
			if (!empty(clientes)){
				desencolar(clientes, idCliente);
				send tomaCabina[idCliente](idCab);
