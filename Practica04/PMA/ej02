Se desea modelar el funcionamiento de un banco en el cual existen 5 cajas para realizar
pagos. Existen P clientes que desean hacer un pago. Para esto, cada una selecciona la caja
donde hay menos personas esperando; una vez seleccionada, espera a ser atendido. En cada
caja, los clientes son atendidos por orden de llegada por los cajeros. Luego del pago, se les
entrega un comprobante. Nota: maximizando la concurrencia.

chan cajas[5](int, int);
chan comCoord(int, String);
chan cajaAsig[P](int);
chan comprobantes[P](text);

process cliente[int id:0..P-1]{
	text comprobante;
	int cajaMia;
	int pago;
	send comCoord(id, "pedir");
	receive cajaAsig[id](cajaMia);
	send cajas[cajaMia](id, pago);
	receive comprobantes[id](comprobante);		
}

process cajero[int id:0..4]{
	text comprobante;
	int idC;
	int pago;
	while (true){
		receive cajas[id](idC, pago);
		send comCoord(id, "atender")
		ejecutarPago(pago, comprobante); //funcion que devuelve el comprobante de pago
		send comprobantes[idC](comprobante);
	}
}

process coordinador{
	int id;
	String tipo;
	int cajaAs;
	int lenColas[5] = ([5] 0);
	
	while(true){
		receive comCoord(id, tipo);
		if (tipo == "pedir") {
			//en este caso id será el id de una persona
			cajaAs = min(lenColas);
			//min devuelve cual es la caja con menos gente esperando
			send cajaAsig[id](cajaAs);
			lencolas[cajaAs]++;
		} elif (tipo == "atender"){
			//en este caso id será el id de una caja
			lenColas[id]--;
		}
	}
}
