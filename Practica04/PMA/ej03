Se debe modelar el funcionamiento de una casa de comida rápida, en la cual trabajan 2
cocineros y 3 vendedores, y que debe atender a C clientes. El modelado debe considerar
que:
- Cada cliente realiza un pedido y luego espera a que se lo entreguen.
- Los pedidos que hacen los clientes son tomados por cualquiera de los vendedores y se
lo pasan a los cocineros para que realicen el plato. Cuando no hay pedidos para atender,
los vendedores aprovechan para reponer un pack de bebidas de la heladera (tardan entre
1 y 3 minutos para hacer esto).
- Repetidamente cada cocinero toma un pedido pendiente dejado por los vendedores, lo
cocina y se lo entrega directamente al cliente correspondiente.
Nota: maximizar la concurrencia

chan pedidos(int,text);
chan comidas[C](text);
chan laburo(int);
chan labura[3](int, text);
chan hayPedido(int, text);

process cliente[int id:0..C-1]{
	text pedido;
	text comida; //asumo que la comida es de tipo texto, se entiende el concepto, se puede cambiar el tipo de variable
	send pedidos(id,pedido);
	receive comidas[id](comida);
}

process vendedor[int id:0..2]{
	text pedido;
	int idC;
	while(true){
		send laburo(id);
		receive labura[id](idC,pedido);
		if (pedido != "VACIO")
			send hayPedido(idC,pedido);
		else delay(random(60,180)); //3 minutos para hacer lo otro
	}
}

process coordinadorVentas{
	int idE;
	int idC;
	text pedido;
	while (true){
		receive laburo(idE);
		if (!empty(pedidos)){
			receive pedidos(idC,pedido);
			send labura[idE] (idC,pedido);
		}else {
			send labura[idE] (-1, "VACIO");
		}
	}
}

process cocinero[int id:0..1]{
	text pedido;
	text comida;
	int idC;
	while(true){
		receive hayPedido(idC,pedido);
		realizarComida(pedido,comida); //devuelve la comida lista
		send comidas[idC](comida);
	}
}
