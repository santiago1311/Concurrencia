    	cola c;
    	do
    		::(contador!=N); alumno[*]?termine(examen,idA);->
    			encolar(c,examen,idA);
    			contador++;
    		::!empty(c); profesor?quierolaburar(); -> 
  			desencolar(c,examen,idA);
  			profesor!labura(examen,idA);  		
    	od
    	profesor?quierolaburar();->labura("NOHAY",-1);
    }
    
    process profesor{
